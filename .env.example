# Copy to .env and fill in. .env is gitignored; never commit it.
# `make configure` writes this file for you and checks that it works.

# Model access. Required in Docker — the `claude -p` fallback needs an
# interactive login that does not exist inside a container.
ANTHROPIC_API_KEY=

# Telegram. Entirely optional: the benchmark, the durability suite and the demo
# all run without it, and approvals work over HTTP.
# Create a bot with @BotFather, then message it once so it can reply to you.
C2C_TELEGRAM_TOKEN=
C2C_TELEGRAM_CHAT_ID=

# Pacing between model calls. Raise it if the backend starts refusing under load.
C2C_MIN_CALL_INTERVAL=1.0
